# Frontend environment for Vite. Copy to .env.local and fill in as needed.

# Backend base URL. Leave empty to use the deployed Render backend,
# or set e.g. http://localhost:8000 for local backend development.
VITE_API_BASE_URL=

# Optional: OAuth scopes requested from the Cognito hosted UI (Google sign-in).
# Add aws.cognito.signin.user.admin only after enabling it on the app client;
# it is required to delete Google accounts from Settings.
# VITE_COGNITO_OAUTH_SCOPES=email openid profile aws.cognito.signin.user.admin
